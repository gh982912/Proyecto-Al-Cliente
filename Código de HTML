// CSS

body {
margin: 0;
font-family: Arial, sans-serif;
background-color: #e6d5f0;
}

/* LOGIN */

.contenedor {
width: 300px;
margin: 100px auto;
padding: 30px;
background-color: white;
border-radius: 10px;
box-shadow: 0 0 10px gray;
}

h1 {
text-align: center;
}

label {
display: block;
margin-top: 15px;
}

input {
width: 100%;
padding: 10px;
margin-top: 5px;
box-sizing: border-box;
border: 1px solid #bbb;
border-radius: 5px;
}

button {
padding: 10px 15px;
margin: 5px;
border: none;
border-radius: 5px;
background-color: #8e44ad;
color: white;
cursor: pointer;
}

button:hover {
background-color: #5b167d;
}

form button {
width: 100%;
margin-top: 20px;
}

p {
text-align: center;
}

a {
color: #6a0dad;
}

/* MENU */

nav {
background-color: #6a0dad;
padding: 15px;
display: flex;
align-items: center;
gap: 5px;
flex-wrap: wrap;
}

nav h2 {
color: white;
margin-right: 20px;
}

nav button {
background-color: #8e44ad;
}

/* CUENTA */

.zonaCuenta {
position: relative;
margin-left: auto;
}

.botonCuenta {
display: flex;
align-items: center;
gap: 8px;
background-color: #8e44ad;
}

.botonCuenta img {
width: 35px;
height: 35px;
border-radius: 50%;
object-fit: cover;
background-color: white;
}

/* MENU DESPLEGABLE */

.menuCuenta {
display: none;

position: absolute;

right: 0;
top: 55px;

width: 240px;

background-color: white;

border-radius: 10px;

box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);

padding: 10px;

z-index: 1000;

}

.menuCuenta.mostrar {
display: block;
}

.menuCuenta button {
display: block;

width: 100%;

margin: 5px 0;

text-align: left;

background-color: white;

color: #333;

}

.menuCuenta button:hover {
background-color: #eee;
}

/* CABECERA DE CUENTA */

.cabeceraCuenta {
display: flex;

align-items: center;

gap: 10px;

padding: 10px;

border-bottom: 1px solid #ddd;

margin-bottom: 5px;

}

.cabeceraCuenta img {
width: 45px;

height: 45px;

border-radius: 50%;

object-fit: cover;

background-color: #ddd;

}

.cabeceraCuenta small {
display: block;

color: gray;

margin-top: 3px;

}

/* BUSCADOR */

.buscador {
padding: 20px;


text-align: center;


}

.buscador input {
width: 80%;


max-width: 500px;

border: 2px solid #8e44ad;

}

/* CONTENIDO */

main {
padding: 30px;
}

.seccion {
background-color: white;


padding: 30px;

border-radius: 10px;

box-shadow: 0 0 8px gray;


}

/* CATEGORIAS */

.categorias {
display: flex;


gap: 20px;

flex-wrap: wrap;


}

.producto {
padding: 20px;


background-color: #eeeeee;

border-radius: 10px;

width: 200px;


}

.producto h3 {
