let telaSeleccionada = "";

function verTela(nombre) {
    const tela = datosTelas[nombre];

    if (!tela) {
        alert("Todavía no hay información de esta tela.");
        return;
    }

    telaSeleccionada = nombre;

    document.getElementById("nombreTela").textContent = nombre;
    document.getElementById("descripcionTela").textContent =
        tela.descripcion;

    document.getElementById("imagenTela").src = tela.imagen;

    document.getElementById("precioTela").textContent =
        "Precio: $" + tela.precio.toLocaleString("es-AR") + " por metro";

    const contenedorColores = document.getElementById("coloresTela");
    contenedorColores.innerHTML = "";

    tela.colores.forEach(color => {
        const botonColor = document.createElement("button");

        botonColor.className = "color-tela";
        botonColor.style.backgroundColor = color;
        botonColor.title = color;

        contenedorColores.appendChild(botonColor);
    });

    document.getElementById("cantidadTela").value = 1;

    document.getElementById("botonAgregarTela").onclick = function () {
        const cantidad = Number(
            document.getElementById("cantidadTela").value
        );

        if (cantidad < 1) {
            alert("Ingresá una cantidad válida.");
            return;
        }

        for (let i = 0; i < cantidad; i++) {
            agregarCarrito(nombre, tela.precio);
        }

        cerrarTela();
    };

    document.getElementById("ventanaTela").style.display = "flex";
}

function cerrarTela() {
    document.getElementById("ventanaTela").style.display = "none";
}
