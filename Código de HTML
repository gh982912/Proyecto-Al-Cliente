// JAVA

function mostrarRegistro() {

document.getElementById("formLogin").style.display = "none";

document.getElementById("formRegistro").style.display = "block";

document.getElementById("titulo").innerHTML = "Registro";

}

function mostrarLogin() {

document.getElementById("formRegistro").style.display = "none";

document.getElementById("formLogin").style.display = "block";

document.getElementById("titulo").innerHTML = "Inicio de Sesión";

}

document.getElementById("formRegistro").addEventListener("submit", function(event) {

event.preventDefault();

let usuario = document.getElementById("registroUsuario").value;

let contraseña = document.getElementById("registroContraseña").value;


if (localStorage.getItem("cuenta_" + usuario)) {

    alert("Ese usuario ya existe.");

    return;
}

let cuenta = {

    usuario: usuario,

    nombre: usuario,

    contraseña: contraseña,

    icono: ""

};

localStorage.setItem(
    "cuenta_" + usuario,
    JSON.stringify(cuenta)
);

alert("Cuenta creada correctamente.");

document.getElementById("registroUsuario").value = "";

document.getElementById("registroContraseña").value = "";

mostrarLogin();

});

document.getElementById("formLogin").addEventListener("submit", function(event) {

event.preventDefault();

let usuario = document.getElementById("loginUsuario").value;

let contraseña = document.getElementById("loginContraseña").value;

let datos = localStorage.getItem("cuenta_" + usuario);

if (!datos) {

    alert("El usuario no existe.");

    return;
}

let cuenta = JSON.parse(datos);

if (cuenta.contraseña !== contraseña) {

    alert("Contraseña incorrecta.");

    return;
}

localStorage.setItem("usuarioActual", usuario);

entrarAlSistema(cuenta);

});

function entrarAlSistema(cuenta) {

document.getElementById("loginRegistro").style.display = "none";

document.getElementById("paginaPrincipal").style.display = "block";


actualizarCuenta(cuenta);

mostrarSeccion("inicio");

}

function actualizarCuenta(cuenta) {

document.getElementById("nombreCuenta").innerText = cuenta.nombre;

document.getElementById("nombreMenu").innerText = cuenta.nombre;


let icono = document.getElementById("iconoCuenta");

let iconoMenu = document.getElementById("iconoMenu");


if (cuenta.icono) {

    icono.src = cuenta.icono;

    iconoMenu.src = cuenta.icono;

} else {

    icono.src =
        "https://cdn-icons-png.flaticon.com/512/149/149071.png";

    iconoMenu.src =
        "https://cdn-icons-png.flaticon.com/512/149/149071.png";

}

}

function abrirCuenta() {

let menu = document.getElementById("menuCuenta");

menu.classList.toggle("mostrar");

}

function editarPerfil() {

let usuario = localStorage.getItem("usuarioActual");

let datos = localStorage.getItem("cuenta_" + usuario);

let cuenta = JSON.parse(datos);


document.getElementById("nuevoNombre").value = cuenta.nombre;


document.getElementById("ventanaPerfil").style.display = "flex";


document.getElementById("menuCuenta").classList.remove("mostrar");

}

function guardarPerfil() {

let usuario = localStorage.getItem("usuarioActual");

let datos = localStorage.getItem("cuenta_" + usuario);

let cuenta = JSON.parse(datos);


let nuevoNombre =
    document.getElementById("nuevoNombre").value;


if (nuevoNombre.trim() === "") {

    alert("El nombre no puede estar vacío.");

    return;
}


cuenta.nombre = nuevoNombre;


localStorage.setItem(
    "cuenta_" + usuario,
    JSON.stringify(cuenta)
);


actualizarCuenta(cuenta);


cerrarVentana();

}

function cerrarVentana() {

document.getElementById("ventanaPerfil").style.display = "none";

}

function cambiarIcono() {

document.getElementById("inputIcono").click();

document.getElementById("menuCuenta").classList.remove("mostrar");

}

function guardarIcono(event) {

let archivo = event.target.files[0];


if (!archivo) {

    return;
}


let lector = new FileReader();


lector.onload = function(e) {

    let usuario = localStorage.getItem("usuarioActual");

    let datos = localStorage.getItem("cuenta_" + usuario);

    let cuenta = JSON.parse(datos);

    cuenta.icono = e.target.result;

    localStorage.setItem(
        "cuenta_" + usuario,
        JSON.stringify(cuenta)
    );


    actualizarCuenta(cuenta);

};

lector.readAsDataURL(archivo);

}

function agregarCuenta() {

localStorage.removeItem("usuarioActual");


document.getElementById("paginaPrincipal").style.display = "none";

document.getElementById("loginRegistro").style.display = "block";


document.getElementById("loginUsuario").value = "";

document.getElementById("loginContraseña").value = "";


mostrarLogin();


document.getElementById("menuCuenta").classList.remove("mostrar");

}

function cambiarCuenta() {

agregarCuenta();

}

function cerrarSesion() {

localStorage.removeItem("usuarioActual");


document.getElementById("paginaPrincipal").style.display = "none";

document.getElementById("loginRegistro").style.display = "block";


document.getElementById("loginUsuario").value = "";

document.getElementById("loginContraseña").value = "";


mostrarLogin();

}

function mostrarSeccion(seccion) {

let secciones =
    document.querySelectorAll(".seccion");


secciones.forEach(function(elemento) {

    elemento.style.display = "none";

});


document.getElementById(seccion).style.display = "block";


if (seccion === "carrito") {

    mostrarCarrito();

}

}

function buscarTelas() {

let texto =
    document.getElementById("busqueda").value.toLowerCase();


let productos =
    document.querySelectorAll(".producto");


productos.forEach(function(producto) {

    let nombre =
        producto.querySelector("h3").innerText.toLowerCase();


    if (nombre.includes(texto)) {

        producto.style.display = "block";

    } else {

        producto.style.display = "none";

    }

});

}

let carrito = [];

function agregarCarrito(nombre, precio) {

carrito.push({

    nombre: nombre,

    precio: precio

});


alert(nombre + " agregado al carrito.");

}

function mostrarCarrito() {

let lista =
    document.getElementById("listaCarrito");


let total = 0;


lista.innerHTML = "";


if (carrito.length === 0) {

    lista.innerHTML =
        "<p>El carrito está vacío.</p>";

}


carrito.forEach(function(producto, index) {

    total += producto.precio;


    lista.innerHTML += `

        <div>

            <h3>${producto.nombre}</h3>

            <p>Precio: $${producto.precio}</p>

            <button onclick="eliminarCarrito(${index})">

                Eliminar

            </button>

        </div>

    `;

});


document.getElementById("totalCarrito").innerText =
    "Total: $" + total;

}

function eliminarCarrito(index) {
carrito.splice(index, 1);

mostrarCarrito();

}

